# PostgreSQL connection string (Neon / Supabase / Prisma Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Long random string for login sessions
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin WhatsApp with country code, no + or spaces
ADMIN_WHATSAPP="91XXXXXXXXXX"

# Shop UPI for customer payments
SHOP_UPI_ID="yourshop@upi"
SHOP_UPI_NAME="Sabzi Bazaar"
SHOP_NAME="Sabzi Bazaar"
NEXT_PUBLIC_SHOP_NAME="Sabzi Bazaar"
NEXT_PUBLIC_SHOP_UPI_ID="yourshop@upi"
